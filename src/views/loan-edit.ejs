<%- include('partials/head', { title: 'Editar empréstimo' }) %>
<%- include('partials/nav', { active }) %>

<main class="page">
  <div class="page-header">
    <h1>Editar empréstimo</h1>
    <p>Altere credor, devedor, valor ou taxa. O saldo será recalculado automaticamente.</p>
  </div>

  <section class="card" style="max-width:560px;">
    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/loans/<%= loan.id %>/edit" method="post">
      <div class="form-group">
        <label for="lenderId">Quem empresta (credor)</label>
        <select id="lenderId" name="lenderId" required>
          <% users.forEach((user) => { %>
          <option value="<%= user.id %>" <%= loan.lenderId === user.id ? 'selected' : '' %>><%= user.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="borrowerId">Quem recebe (devedor)</label>
        <select id="borrowerId" name="borrowerId" required>
          <% users.forEach((user) => { %>
          <option value="<%= user.id %>" <%= loan.borrowerId === user.id ? 'selected' : '' %>><%= user.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="principal">Valor principal (R$)</label>
          <input id="principal" name="principal" type="number" step="0.01" min="0.01" value="<%= Number(loan.principal).toFixed(2) %>" required />
        </div>
        <div class="form-group">
          <label for="interestRate">Taxa mensal (%)</label>
          <input id="interestRate" name="interestRate" type="number" step="0.01" min="0" value="<%= Number(loan.interestRate).toFixed(2) %>" required />
        </div>
      </div>

      <div class="form-actions">
        <a href="/loans/<%= loan.id %>" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Salvar alterações</button>
      </div>
    </form>
  </section>
</main>

<%- include('partials/footer') %>
