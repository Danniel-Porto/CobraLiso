<%- include('partials/head', { title: 'Empréstimo' }) %>
<%- include('partials/nav', { active }) %>

<main class="page">
  <% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
  <% } %>

  <div class="loan-hero">
    <div>
      <div class="loan-hero-parties">
        <%= lender?.name || "?" %>
        <span class="loan-hero-arrow">→</span>
        <%= borrower?.name || "?" %>
      </div>
      <div class="loan-hero-meta">
        <span>Principal: <strong><%= formatMoney(loan.principal) %></strong></span>
        <span>Taxa: <strong><%= Number(loan.interestRate).toFixed(2) %>%/mês</strong></span>
        <span class="badge <%= statusBadge(loan.status) %>"><%= statusLabel(loan.status) %></span>
      </div>
      <div class="hero-actions">
        <a href="/loans/<%= loan.id %>/edit" class="btn btn-secondary btn-sm">✏️ Editar</a>
        <button
          type="button"
          class="btn btn-danger btn-sm"
          data-confirm-delete
          data-confirm-title="Excluir empréstimo?"
          data-confirm-message="O empréstimo será ocultado da lista. Pagamentos e histórico permanecem no banco para recuperação."
          data-confirm-action="/loans/<%= loan.id %>/delete"
        >
          🗑️ Excluir
        </button>
      </div>
    </div>
    <div class="loan-hero-balance">
      <label>Saldo devedor</label>
      <div class="amount"><%= formatMoney(loan.balance) %></div>
    </div>
  </div>

  <div class="detail-grid">
    <% if (loan.status === 'active' && Number(loan.balance) > 0) { %>
    <section class="card">
      <h2 class="card-title">Registrar pagamento</h2>
      <p class="card-subtitle">
        <% if (isBorrower) { %>Informe quanto você pagou agora.<% } else { %>Registre um pagamento recebido.<% } %>
      </p>

      <form action="/loans/<%= loan.id %>/payments" method="post" enctype="multipart/form-data">
        <div class="form-group">
          <label for="amount">Valor pago</label>
          <input id="amount" name="amount" type="number" min="0.01" step="0.01" max="<%= loan.balance %>" placeholder="0,00" required />
        </div>

        <div class="form-group">
          <label for="note">Observação</label>
          <textarea id="note" name="note" rows="2" placeholder="Ex: PIX, parcela parcial…"></textarea>
        </div>

        <div class="form-group">
          <label>Comprovante (opcional)</label>
          <div class="file-input-wrap">
            <div class="file-input-display">
              <span class="icon">📎</span>
              <span class="file-label">Escolher PDF…</span>
            </div>
            <input id="receiptFile" name="receiptFile" type="file" accept="application/pdf,.pdf" />
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Registrar pagamento</button>
      </form>
    </section>
    <% } else { %>
    <section class="card">
      <div class="empty-state" style="padding:24px;">
        <div class="empty-state-icon">✅</div>
        <h3>Empréstimo quitado</h3>
        <p class="mb-0">Não há saldo pendente para pagamento.</p>
      </div>
    </section>
    <% } %>

    <section class="card">
      <button type="button" class="collapse-trigger" data-collapse="simulator" aria-expanded="<%= simulation ? 'true' : 'false' %>">
        <span>📊 Simulador de quitação</span>
        <span class="chevron">▼</span>
      </button>
      <div id="simulator" class="collapse-body<%= simulation ? ' open' : '' %>">
        <p class="card-subtitle mt-0">Projeção com juros + parcelas variáveis. Não altera o saldo real.</p>

        <form action="/loans/<%= loan.id %>/simulate" method="post">
          <div class="form-row">
            <div class="form-group">
              <label for="firstPayment">Parcela inicial</label>
              <input id="firstPayment" name="firstPayment" type="number" step="0.01" min="0" value="2000" />
            </div>
            <div class="form-group">
              <label for="afterMonth">Mudar após mês</label>
              <input id="afterMonth" name="afterMonth" type="number" step="1" min="0" value="6" />
            </div>
            <div class="form-group">
              <label for="secondPayment">Nova parcela</label>
              <input id="secondPayment" name="secondPayment" type="number" step="0.01" min="0" value="4000" />
            </div>
          </div>
          <button type="submit" class="btn btn-secondary">Simular</button>
        </form>

        <% if (simulation) { %>
        <div style="margin-top:20px;padding-top:20px;border-top:1px solid var(--border-soft);">
          <div class="stats-grid" style="margin-bottom:16px;">
            <div class="stat-card">
              <div class="stat-label">Juros totais</div>
              <div class="stat-value" style="font-size:1.1rem;"><%= formatMoney(simulation.totalInterest) %></div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Meses</div>
              <div class="stat-value" style="font-size:1.1rem;"><%= simulation.schedule.length %></div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Saldo final</div>
              <div class="stat-value" style="font-size:1.1rem;"><%= formatMoney(simulation.remainingBalance) %></div>
            </div>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Mês</th>
                  <th>Juros</th>
                  <th>Pagamento</th>
                  <th>Saldo</th>
                </tr>
              </thead>
              <tbody>
                <% simulation.schedule.slice(0, 24).forEach((item) => { %>
                <tr>
                  <td><%= item.month %></td>
                  <td><%= formatMoney(item.interest) %></td>
                  <td><%= formatMoney(item.payment) %></td>
                  <td><%= formatMoney(item.balance) %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (simulation.schedule.length > 24) { %>
          <p class="hint" style="margin-top:12px;">Exibindo os primeiros 24 meses.</p>
          <% } %>
        </div>
        <% } %>
      </div>
    </section>
  </div>

  <section class="card">
    <h2 class="card-title">Histórico</h2>
    <p class="card-subtitle">Pagamentos, juros e comprovantes anexados.</p>

    <% if (!transactions.length) { %>
    <div class="empty-state">
      <div class="empty-state-icon">📋</div>
      <h3>Nenhuma movimentação</h3>
      <p class="mb-0">As transações aparecerão aqui conforme pagamentos e fechamentos mensais.</p>
    </div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Data</th>
            <th>Tipo</th>
            <th>Valor</th>
            <th>Obs.</th>
            <th>Comprovante</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach((tx) => { %>
          <tr>
            <td><%= new Date(tx.createdAt).toLocaleString("pt-BR", { dateStyle: "short", timeStyle: "short" }) %></td>
            <td><span class="badge <%= txTypeBadge(tx.type) %>"><%= txTypeLabel(tx.type) %></span></td>
            <td><strong><%= formatMoney(tx.amount) %></strong></td>
            <td class="muted"><%= tx.note || "—" %></td>
            <td>
              <% if (tx.attachmentBase64) { %>
              <a href="/transactions/<%= tx.id %>/attachment/download" class="btn btn-ghost btn-sm">📄 PDF</a>
              <% } else if (tx.type === 'payment') { %>
              <form action="/transactions/<%= tx.id %>/attachment" method="post" enctype="multipart/form-data" class="inline-form">
                <div class="file-input-wrap">
                  <div class="file-input-display">
                    <span class="file-label">PDF…</span>
                  </div>
                  <input name="receiptFile" type="file" accept="application/pdf,.pdf" required />
                </div>
                <button type="submit" class="btn btn-ghost btn-sm">Anexar</button>
              </form>
              <% } else { %>
              <span class="muted">—</span>
              <% } %>
            </td>
            <td>
              <% if (tx.type === 'payment') { %>
              <div class="row-actions">
                <a href="/transactions/<%= tx.id %>/edit" class="btn btn-ghost btn-sm">Editar</a>
                <button
                  type="button"
                  class="btn btn-danger btn-sm"
                  data-confirm-delete
                  data-confirm-title="Excluir pagamento?"
                  data-confirm-message="O pagamento de <%= formatMoney(tx.amount) %> será removido e o saldo do empréstimo será recalculado."
                  data-confirm-action="/transactions/<%= tx.id %>/delete"
                >
                  Excluir
                </button>
              </div>
              <% } else { %>
              <span class="muted">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
